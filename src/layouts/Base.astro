---
import { url } from '../utils/url';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import displayFont from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';
import serifFont from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-italic.woff2?url';
import monoFont from '@fontsource/dm-mono/files/dm-mono-latin-400-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = 'Concept site for Halde, a fictional architecture studio in Copenhagen, built around a live 3D study of the real sun through the year.',
} = Astro.props;
const fullTitle = title ? `${title} | Halde Architects` : 'Halde Architects | Architecture shaped by light';
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(url('/og.jpg'), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f1ec" />
    <meta name="color-scheme" content="light" />
    <style is:inline>
      html {
        background: #f3f1ec;
      }
    </style>
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="White architectural model of a house on a board, with long morning shadows" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const stored = (key) => {
          try {
            return sessionStorage.getItem(key);
          } catch {
            return null;
          }
        };
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        if (matchMedia('(pointer: fine)').matches) root.classList.add('has-scrollbar');
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.classList.add('motion');
          if (stored('halde:intro')) root.classList.add('is-returning');
        }
        // If the scripts never arrive, show the page rather than hide it behind its reveals.
        setTimeout(() => root.classList.contains('motion-ready') || root.classList.remove('motion', 'has-scrollbar'), 4000);
      })();
    </script>
  </head>
  <body>
    <a class="skip mono" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <div class="cursor" data-cursor-el aria-hidden="true"><span>View</span></div>
    <div class="grain" aria-hidden="true"></div>
    <div class="blueprint grid" aria-hidden="true">
      {Array.from({ length: 12 }, () => <div />)}
    </div>
    <div class="scrollbar" data-scrollbar aria-hidden="true">
      <div class="scrollbar__ticks" data-scrollbar-ticks></div>
      <div class="scrollbar__thumb" data-scrollbar-thumb></div>
    </div>

    <!-- Runs before the first paint, so a reload lands in place with nothing to re-animate. -->
    <script is:inline>
      (() => {
        const key = `halde:scroll:${location.pathname}`;
        addEventListener('pagehide', () => {
          try {
            sessionStorage.setItem(key, String(scrollY));
          } catch {
            // private modes can refuse storage; the page simply reopens at the top
          }
        });

        const [entry] = performance.getEntriesByType('navigation');
        if (entry?.type === 'reload' || entry?.type === 'back_forward') {
          let y = 0;
          try {
            y = Number(sessionStorage.getItem(key)) || 0;
          } catch {
            y = 0;
          }
          if (y) scrollTo(0, y);
          const line = innerHeight * 0.94;
          for (const el of document.querySelectorAll('[data-reveal]')) {
            if (el.getBoundingClientRect().top >= line) continue;
            el.dataset.seen = '';
            if (el.dataset.reveal !== 'image') continue;
            el.classList.add('is-revealed');
            // On screen again: skip lazy loading so the cached photo paints with the page.
            for (const img of el.querySelectorAll('img')) {
              img.loading = 'eager';
              img.decoding = 'sync';
            }
          }
        }

        document.querySelector('[data-nav]')?.classList.toggle('is-scrolled', scrollY > 40);

        const time = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Copenhagen', hour: '2-digit', minute: '2-digit', second: '2-digit' }).format();
        for (const el of document.querySelectorAll('[data-cph-time]')) el.textContent = time;
      })();
    </script>

    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>

<style>
  .skip {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 200;
    padding: 0.6rem 0.9rem;
    background: var(--ink);
    color: var(--paper);
    transform: translateY(-200%);
  }
  .skip:focus {
    transform: none;
  }
  .cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 150;
    pointer-events: none;
    width: 0;
    height: 0;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .cursor.is-on {
    opacity: 1;
  }
  .cursor span {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 6.5rem;
    height: 6.5rem;
    margin: -3.25rem 0 0 -3.25rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--f-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transform: scale(0.08);
    transition: transform 0.55s var(--ease-out);
  }
  .cursor span {
    color: transparent;
  }
  .cursor.is-big span {
    transform: scale(1);
    color: var(--paper);
  }
  @media (pointer: coarse) {
    .cursor {
      display: none;
    }
  }
</style>
