---
import { url } from '../utils/url';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: url('/work'), label: 'Work' },
  { href: url('/studio'), label: 'Studio' },
  { href: '#contact', label: 'Contact' },
];
const isCurrent = (href: string) => href !== '#contact' && path.startsWith(href);
---

<header class="nav" data-nav>
  <div class="nav__inner wrap">
    <a href={url('/')} class="nav__logo" aria-label="Halde Architects, home">
      <svg viewBox="0 0 24 24" aria-hidden="true" class="nav__mark">
        <rect x="1" y="1" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4"></rect>
        <path d="M1 23 L23 1 L23 23 Z" fill="currentColor"></path>
      </svg>
      <span>Halde</span>
    </a>

    <p class="nav__time mono" aria-label="Local time in Copenhagen">
      <span class="muted">CPH</span> <span data-cph-time>--:--:--</span>
    </p>

    <nav aria-label="Primary">
      <ul class="nav__links">
        {links.map((l) => (
          <li>
            <a href={l.href} class="ulink" aria-current={isCurrent(l.href) ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 80;
    height: var(--nav-h);
    transition:
      transform 0.7s var(--ease-out),
      background-color 0.5s,
      border-color 0.5s;
    border-bottom: 1px solid transparent;
    view-transition-name: nav;
  }
  .nav:global(.is-scrolled) {
    background: rgb(243 241 236 / 0.82);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-color: var(--line);
  }
  .nav:global(.is-hidden) {
    transform: translateY(-100%);
  }
  .nav__inner {
    height: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }
  .nav__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    font-size: 1.2rem;
    letter-spacing: -0.04em;
    justify-self: start;
  }
  .nav__mark {
    width: 1.15rem;
    transition: transform 0.9s var(--ease-out);
  }
  .nav__logo:hover .nav__mark {
    transform: rotate(-90deg);
  }
  .nav__time {
    font-variant-numeric: tabular-nums;
  }
  .nav__links {
    display: flex;
    gap: clamp(1rem, 2.5vw, 2.25rem);
    justify-content: flex-end;
    font-size: var(--fs-small);
  }
  @media (max-width: 640px) {
    .nav__inner {
      grid-template-columns: auto 1fr;
    }
    .nav__time {
      display: none;
    }
  }
</style>
