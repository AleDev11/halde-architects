---
import { Image } from 'astro:assets';
import fallback from '../assets/img/model_2.jpg';

const ticks = Array.from({ length: 13 }, (_, i) => 7 + i);
---

<section class="sun" data-sun-section aria-label="Sun study introduction">
  <div class="sun__sticky" data-sun>
    <div class="sun__glow" aria-hidden="true"></div>
    <canvas class="sun__canvas" aria-hidden="true"></canvas>
    <Image class="sun__fallback" src={fallback} alt="" widths={[800, 1600]} sizes="100vw" loading="eager" />

    <div class="sun__meta wrap">
      <div class="mono">
        <p>Fig. 01 — Sun study</p>
        <p class="muted">21 June · 55.676° N, 12.568° E</p>
      </div>
      <div class="sun__north mono" aria-hidden="true">
        <span class="sun__north-dial" data-north>
          <svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="19" fill="none" stroke="currentColor" stroke-width="0.8"></circle><path d="M20 5 L24 22 L20 19 L16 22 Z" fill="currentColor"></path></svg>
        </span>
        N
      </div>
    </div>

    <div class="sun__copy wrap">
      <h1 class="h1 sun__title">
        <span class="sun__line"><span data-intro>Architecture</span></span>
        <span class="sun__line"><span data-intro>shaped by <em class="serif">light.</em></span></span>
      </h1>

      <div class="sun__side">
        <div class="sun__phases" aria-live="polite">
          <p data-phase class="is-active"><span class="mono muted">Morning</span>Light arrives low from the east and finds the rooms we wake up in.</p>
          <p data-phase><span class="mono muted">Midday</span>At its highest, the sun is held back by deep reveals and a floating roof.</p>
          <p data-phase><span class="mono muted">Evening</span>Long shadows stretch across the garden. The house turns west to watch.</p>
        </div>
        <a href="#work" class="arrow mono sun__cta" data-intro-fade>
          Selected work
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M8 2v12M3 9l5 5 5-5"></path></svg>
        </a>
      </div>
    </div>

    <div class="sun__dial wrap" data-intro-fade>
      <div class="sun__readout mono">
        <span class="sun__time" data-sun-time>06:30</span>
        <span><span class="muted">AZ</span> <span data-sun-az>—</span></span>
        <span><span class="muted">EL</span> <span data-sun-el>—</span></span>
      </div>
      <div class="sun__track" aria-hidden="true">
        <div class="sun__progress"></div>
        {ticks.map((h) => (
          <span class:list={['sun__tick mono', { major: h % 2 === 0 }]} style={`--i:${(h - 6.5) / 13}`}>
            {h % 2 === 0 && <b>{String(h).padStart(2, '0')}</b>}
          </span>
        ))}
      </div>
      <p class="mono muted sun__hint">Scroll to move the sun</p>
    </div>
  </div>
</section>

<script>
  import { animate, stagger } from 'animejs';

  const root = document.querySelector<HTMLElement>('[data-sun]');
  if (root) {
    if (document.documentElement.classList.contains('motion')) {
      animate('[data-intro]', { y: ['110%', '0%'], duration: 1400, delay: stagger(110, { start: 150 }), ease: 'out(4)' });
      animate('[data-intro-fade], .sun__meta, .sun__phases', { opacity: [0, 1], duration: 1100, delay: stagger(90, { start: 700 }), ease: 'out(3)' });
    }
    // Three.js loads after the headline has painted, so text never waits on WebGL
    const start = () => import('../scripts/sun-study').then((m) => m.initSunStudy(root));
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 700 });
    else setTimeout(start, 200);
  }
</script>

<style>
  .sun {
    position: relative;
    height: 340vh;
  }
  .sun__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    --day: 0;
    --warmth: 1;
    --sun-x: 90%;
  }
  .sun__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(60vmax 50vmax at var(--sun-x) 8%, rgb(255 190 140 / calc(var(--warmth) * 0.38)), transparent 70%);
    pointer-events: none;
  }
  .sun__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.8s;
  }
  :global(.has-gl) .sun__canvas {
    opacity: 1;
  }
  .sun__fallback {
    display: none;
  }
  :global(.no-webgl) .sun__fallback {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.6;
  }

  .sun__meta {
    position: absolute;
    top: calc(var(--nav-h) + 1.25rem);
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .sun__north {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }
  .sun__north-dial {
    width: 2.5rem;
    display: block;
  }

  .sun__copy {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(7.5rem, 17vh, 10rem);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    pointer-events: none;
  }
  .sun__copy a {
    pointer-events: auto;
  }
  .sun__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
    margin-bottom: -0.06em;
  }
  .sun__line > span {
    display: block;
  }
  .sun__title em {
    font-weight: 300;
    letter-spacing: -0.04em;
    padding-right: 0.05em;
  }
  .sun__side {
    width: min(19rem, 32vw);
    display: grid;
    gap: 2rem;
    padding-bottom: 0.6rem;
  }
  .sun__phases {
    display: grid;
  }
  .sun__phases p {
    grid-area: 1 / 1;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--ink-2);
    opacity: 0;
    transform: translateY(0.6rem);
    transition:
      opacity 0.7s var(--ease-out),
      transform 0.7s var(--ease-out);
  }
  .sun__phases p.is-active {
    opacity: 1;
    transform: none;
  }
  .sun__phases span {
    display: block;
    margin-bottom: 0.5rem;
  }

  .sun__dial {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.75rem;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: end;
    gap: clamp(1rem, 3vw, 3rem);
  }
  .sun__readout {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    white-space: nowrap;
  }
  .sun__time {
    font-size: 1.6rem;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .sun__track {
    position: relative;
    height: 2.25rem;
    border-bottom: 1px solid var(--line-strong);
  }
  .sun__progress {
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 1px;
    width: calc(var(--day) * 100%);
    background: var(--accent);
  }
  .sun__progress::after {
    content: '';
    position: absolute;
    right: -4px;
    bottom: -4px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
  }
  .sun__tick {
    position: absolute;
    left: calc(var(--i) * 100%);
    bottom: 0;
    width: 1px;
    height: 0.35rem;
    background: var(--line-strong);
  }
  .sun__tick.major {
    height: 0.65rem;
  }
  .sun__tick b {
    position: absolute;
    bottom: 1rem;
    left: 0;
    transform: translateX(-50%);
    font-weight: 400;
    font-size: 0.625rem;
    color: var(--stone);
  }
  .sun__hint {
    white-space: nowrap;
  }

  :global(html.motion) .sun__meta,
  :global(html.motion) .sun__phases,
  :global(html.motion) [data-intro-fade] {
    opacity: 0;
  }
  :global(html.motion) [data-intro] {
    transform: translateY(110%);
  }

  @media (max-width: 760px) {
    .sun {
      height: 280vh;
    }
    .sun__copy {
      flex-direction: column;
      align-items: flex-start;
      bottom: 7rem;
    }
    .sun__side {
      width: 100%;
      gap: 1rem;
    }
    .sun__cta {
      display: none;
    }
    .sun__dial {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .sun__hint {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sun {
      height: 100vh;
    }
    .sun__hint {
      visibility: hidden;
    }
  }
</style>
