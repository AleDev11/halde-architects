---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SunStudy from '../components/SunStudy.astro';
import ProjectCard from '../components/ProjectCard.astro';
import modelImg from '../assets/img/model_1.jpg';
import lightImg from '../assets/img/light_1.jpg';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const manifesto =
  'We are a studio of eleven architects in Copenhagen. We treat every building as an instrument for measuring light: the hour a room is used decides how it is shaped. We draw slowly, build carefully, and leave room for weather, time and the people who come after us.';

const steps = [
  { t: 'Observe', d: 'We spend a full day on site, from first light to last, before a single line is drawn.' },
  { t: 'Measure', d: 'Sun paths, wind, sightlines and sound are mapped into a light study for every room.' },
  { t: 'Shape', d: 'Plans are cut and turned until each room meets its hour. Models are built by hand at 1:50.' },
  { t: 'Build', d: 'We stay on site through construction, adjusting openings as the real light arrives.' },
];

const stats = [
  { n: 14, l: 'Years in practice' },
  { n: 62, l: 'Buildings completed' },
  { n: 11, l: 'Architects & makers' },
  { n: 9, l: 'International awards' },
];

const layouts = ['a', 'b', 'c', 'd'] as const;
---

<Base>
  <SunStudy />

  <!-- Manifesto -->
  <section class="manifesto wrap grid">
    <p class="label mono manifesto__label" data-n="01">Studio</p>
    <div class="manifesto__img frame" data-reveal="image">
      <Image src={modelImg} alt="White card model of a small house on a table" widths={[400, 800]} sizes="(max-width: 760px) 50vw, 22vw" />
    </div>
    <p class="manifesto__text" data-manifesto>{manifesto}</p>
    <a href="/studio" class="arrow mono manifesto__link" data-reveal="fade">
      About the studio
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M2 8h12M9 3l5 5-5 5"></path></svg>
    </a>
  </section>

  <!-- Selected work -->
  <section class="work wrap" id="work">
    <header class="work__head grid">
      <p class="label mono" data-n="02">Selected work</p>
      <h2 class="h2 work__title" data-reveal="lines">Buildings that keep time.</h2>
      <p class="mono muted work__count">({String(projects.length).padStart(2, '0')})</p>
    </header>
    <div class="work__grid grid">
      {projects.map((p, i) => <ProjectCard project={p} index={i} variant={layouts[i % layouts.length]} />)}
    </div>
    <div class="work__more">
      <hr class="rule" data-reveal="rule" />
      <a href="/work" class="arrow work__all">
        <span class="h3">All projects</span>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1"><path d="M2 8h12M9 3l5 5-5 5"></path></svg>
      </a>
    </div>
  </section>

  <!-- Approach -->
  <section class="approach wrap bt">
    <header class="approach__head grid">
      <p class="label mono" data-n="03">Approach</p>
      <h2 class="h2 approach__title" data-reveal="lines">Four steps. The same, <em class="serif">every time.</em></h2>
    </header>
    <ol class="approach__list grid">
      {
        steps.map((s, i) => (
          <li class="step" data-reveal="fade" data-delay={i * 120}>
            <svg class="step__fig" viewBox="0 0 120 80" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
              {i === 0 && (
                <>
                  <path class="draw" d="M4 70 H116" />
                  <path class="draw" d="M14 70 A46 46 0 0 1 106 70" stroke-dasharray="2 3" />
                  <circle class="draw" cx="30" cy="38" r="5" />
                </>
              )}
              {i === 1 && (
                <>
                  <path class="draw" d="M10 70 L60 10 L110 70 Z" />
                  <path class="draw" d="M60 10 V70 M35 40 H85" />
                  <path class="draw" d="M10 70 L110 70" />
                </>
              )}
              {i === 2 && (
                <>
                  <path class="draw" d="M16 70 V34 H58 V70 M58 52 H100 V70 M8 70 H112" />
                  <path class="draw" d="M16 34 L58 12" />
                </>
              )}
              {i === 3 && (
                <>
                  <path class="draw" d="M20 70 V20 H100 V70 M8 70 H112" />
                  <path class="draw" d="M20 36 H100 M20 53 H100 M46 20 V70 M74 20 V70" />
                </>
              )}
            </svg>
            <span class="mono step__n">0{i + 1}</span>
            <h3 class="h3 step__t">{s.t}</h3>
            <p class="step__d">{s.d}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Light quote -->
  <section class="light wrap grid">
    <div class="light__img frame" data-reveal="image">
      <div class="light__inner" data-parallax="8">
        <Image src={lightImg} alt="Sunlight falling in a tall slot across a pale wall" widths={[600, 1000, 1600]} sizes="(max-width: 760px) 100vw, 50vw" />
      </div>
    </div>
    <blockquote class="light__quote">
      <p class="serif" data-reveal="lines">
        “Light is the first material. Concrete, timber and brick only give it somewhere to land.”
      </p>
      <footer class="mono" data-reveal="fade">
        Ida Halde <span class="muted">— Founding Partner</span>
      </footer>
    </blockquote>
  </section>

  <!-- Stats -->
  <section class="stats wrap">
    <ul class="stats__list grid">
      {
        stats.map((s) => (
          <li class="stat">
            <hr class="rule" data-reveal="rule" />
            <span class="stat__n" data-count={s.n} data-pad="2">
              {String(s.n).padStart(2, '0')}
            </span>
            <span class="mono muted">{s.l}</span>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<script>
  import { animate, onScroll, splitText, stagger, svg } from 'animejs';

  if (document.documentElement.classList.contains('motion')) {
    // Manifesto words brighten as they scroll through the viewport
    const text = document.querySelector<HTMLElement>('[data-manifesto]');
    if (text) {
      const { words } = splitText(text, { words: true });
      animate(words, {
        opacity: [0.14, 1],
        ease: 'linear',
        delay: stagger(40),
        duration: 300,
        autoplay: onScroll({ target: text, enter: 'bottom-=15% top', leave: 'center+=10% bottom', sync: 0.4 }),
      });
    }

    // Approach diagrams draw themselves
    document.querySelectorAll<SVGElement>('.step__fig').forEach((fig, i) => {
      const lines = svg.createDrawable(fig.querySelectorAll('.draw'));
      animate(lines, {
        draw: ['0 0', '0 1'],
        duration: 1800,
        delay: stagger(220, { start: i * 140 }),
        ease: 'inOut(3)',
        autoplay: onScroll({ target: fig, enter: 'bottom-=10% top' }),
      });
    });
  }
</script>

<style>
  /* Manifesto */
  .manifesto {
    padding-block: clamp(7rem, 16vw, 14rem) clamp(5rem, 10vw, 9rem);
    row-gap: 2.5rem;
    align-items: start;
  }
  .manifesto__label {
    grid-column: 1 / span 3;
  }
  .manifesto__img {
    grid-column: 1 / span 3;
    grid-row: 2 / span 2;
    aspect-ratio: 3 / 4;
    align-self: end;
  }
  .manifesto__text {
    grid-column: 5 / -1;
    grid-row: 1 / span 2;
    font-size: clamp(1.6rem, 0.9rem + 2.6vw, 3.5rem);
    line-height: 1.12;
    letter-spacing: -0.035em;
  }
  .manifesto__link {
    grid-column: 5 / -1;
  }
  @media (max-width: 760px) {
    .manifesto__label,
    .manifesto__text,
    .manifesto__link {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .manifesto__img {
      grid-column: 1 / span 3;
      grid-row: auto;
    }
  }

  /* Work */
  .work {
    padding-bottom: clamp(5rem, 10vw, 9rem);
  }
  .work__head {
    align-items: end;
    padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
    row-gap: 1.5rem;
  }
  .work__head .label {
    grid-column: 1 / span 3;
    align-self: start;
  }
  .work__title {
    grid-column: 4 / span 7;
  }
  .work__count {
    grid-column: 11 / -1;
    justify-self: end;
  }
  .work__grid {
    row-gap: clamp(4rem, 9vw, 9rem);
  }
  .work__more {
    margin-top: clamp(4rem, 8vw, 7rem);
  }
  .work__all {
    justify-content: space-between;
    width: 100%;
    padding-top: 1.5rem;
  }
  .work__all svg {
    width: clamp(1.5rem, 3vw, 2.5rem);
  }
  @media (max-width: 760px) {
    .work__head .label,
    .work__title {
      grid-column: 1 / -1;
    }
    .work__count {
      display: none;
    }
  }

  /* Approach */
  .approach {
    padding-block: clamp(5rem, 10vw, 9rem);
  }
  .approach__head {
    row-gap: 1.5rem;
    margin-bottom: clamp(3.5rem, 7vw, 6rem);
  }
  .approach__head .label {
    grid-column: 1 / span 3;
  }
  .approach__title {
    grid-column: 4 / -1;
    max-width: 14ch;
  }
  .approach__list {
    row-gap: 3.5rem;
  }
  .step {
    grid-column: span 3;
    display: grid;
    align-content: start;
    gap: 0.9rem;
    padding-right: 1rem;
  }
  .step__fig {
    width: 100%;
    max-width: 9rem;
    margin-bottom: 1.5rem;
    color: var(--ink-2);
  }
  .step__n {
    color: var(--accent);
  }
  .step__d {
    color: var(--ink-2);
    font-size: var(--fs-small);
    max-width: 30ch;
  }
  @media (max-width: 1000px) {
    .step {
      grid-column: span 6;
    }
  }
  @media (max-width: 760px) {
    .approach__head .label,
    .approach__title {
      grid-column: 1 / -1;
    }
  }

  /* Light */
  .light {
    padding-block: clamp(3rem, 6vw, 5rem) clamp(5rem, 10vw, 9rem);
    align-items: center;
    row-gap: 3rem;
  }
  .light__img {
    grid-column: 1 / span 6;
    aspect-ratio: 4 / 5;
  }
  .light__inner {
    position: absolute;
    inset: -10% 0;
  }
  .light__inner img {
    height: 100%;
  }
  .light__quote {
    grid-column: 8 / -1;
  }
  .light__quote p {
    font-size: clamp(1.9rem, 1rem + 3vw, 4rem);
    line-height: 1.04;
  }
  .light__quote footer {
    margin-top: 2.5rem;
  }
  @media (max-width: 760px) {
    .light__img,
    .light__quote {
      grid-column: 1 / -1;
    }
  }

  /* Stats */
  .stats {
    padding-bottom: clamp(6rem, 12vw, 11rem);
  }
  .stats__list {
    row-gap: 3rem;
  }
  .stat {
    grid-column: span 3;
    display: grid;
    gap: 0.75rem;
  }
  .stat .rule {
    margin-bottom: 1rem;
  }
  .stat__n {
    font-size: clamp(4rem, 2rem + 6vw, 8.5rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 0.9;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 760px) {
    .stat {
      grid-column: span 3;
    }
  }
</style>
